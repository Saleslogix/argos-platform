<?xml version="1.0" encoding="utf-8"?>
<!--
  Cordova configuration for the Argos SalesLogix native shell.

  The ${VERSION} and ${VERSION_CODE} placeholders below are filled at prepare
  time by cordova/hooks/before_prepare/010-set-version.js, which reads the
  version from products/argos-saleslogix/package.json and derives the version
  code from the Jenkins BUILD_NUMBER environment variable.

  Every <plugin> spec and every <engine> spec must stay in exact lockstep with
  cordova/package.json. The cordova/hooks/before_prepare/020-check-plugins.js
  hook cross-checks the two files and fails the build on any mismatch or any
  non-exact (range-operator) version pin.

  The <access> and <allow-navigation> host values below are example values for
  the integration environment. Customer-specific builds replace them with the
  Server_Endpoint hosts and the Mingle authorization host (mingleSettings.pu)
  for the target environment.
-->
<widget id="com.infor.crm.mobile" version="${VERSION}"
        android-versionCode="${VERSION_CODE}"
        ios-CFBundleVersion="${VERSION_CODE}"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Infor CRM SLX</name>
  <description>Argos SalesLogix mobile application.</description>
  <author email="support@infor.com" href="https://www.infor.com">Infor</author>

  <content src="index.html" />

  <!-- before_prepare hooks: stamp version/versionCode into this file and
       cross-check the plugin declarations against package.json. Cordova only
       runs hooks that are declared here; the hooks/ directory is not
       auto-scanned. -->
  <hook type="before_prepare" src="hooks/before_prepare/010-set-version.js" />
  <hook type="before_prepare" src="hooks/before_prepare/020-check-plugins.js" />
  <hook type="after_build" src="hooks/after_build/010-collect-artifacts.js" />

  <!-- Allowed origins: filled per-environment; example values shown. -->
  <access origin="https://*.infor.com" />
  <access origin="https://mingleinteg01-ionapi.mingledev.infor.com" />
  <access origin="https://mingleinteg01-sso.mingledev.infor.com" />

  <!-- WebView navigation is restricted to the Server_Endpoint hosts and the
       Mingle authorization host, plus the custom OAuth callback scheme. -->
  <allow-navigation href="https://*.infor.com/*" />
  <allow-navigation href="https://mingleinteg01-ionapi.mingledev.infor.com/*" />
  <allow-navigation href="https://mingleinteg01-sso.mingledev.infor.com/*" />
  <allow-navigation href="infor-crm-slx://*" />

  <!-- External links opened with target="_system" launch the device browser. -->
  <allow-intent href="https://*/*" />
  <allow-intent href="http://*/*" />

  <preference name="DisallowOverscroll" value="true" />

  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />

    <!-- cordova-android 15 uses the native Android 12+ splash screen API.
         The legacy <splash> image tags are no longer supported; the splash
         icon is supplied via the AndroidWindowSplashScreenAnimatedIcon
         preference instead. -->
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/icon-xxxhdpi.png" />
    <preference name="AndroidWindowSplashScreenBackgroundColor" value="#FFFFFF" />

    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
      <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    </config-file>

    <icon density="mdpi"    src="resources/android/icon-mdpi.png" />
    <icon density="hdpi"    src="resources/android/icon-hdpi.png" />
    <icon density="xhdpi"   src="resources/android/icon-xhdpi.png" />
    <icon density="xxhdpi"  src="resources/android/icon-xxhdpi.png" />
    <icon density="xxxhdpi" src="resources/android/icon-xxxhdpi.png" />
  </platform>

  <platform name="ios">
    <preference name="deployment-target" value="13.0" />

    <edit-config file="*-Info.plist" target="NSLocationWhenInUseUsageDescription" mode="merge">
      <string>Infor CRM SLX uses your location to find and show accounts near you.</string>
    </edit-config>

    <icon src="resources/ios/AppIcon-1024.png" width="1024" height="1024" />
    <icon src="resources/ios/AppIcon-180.png"  width="180"  height="180" />
    <icon src="resources/ios/AppIcon-167.png"  width="167"  height="167" />
    <icon src="resources/ios/AppIcon-152.png"  width="152"  height="152" />
    <icon src="resources/ios/AppIcon-120.png"  width="120"  height="120" />
    <icon src="resources/ios/AppIcon-80.png"   width="80"   height="80" />
    <icon src="resources/ios/AppIcon-60.png"   width="60"   height="60" />
    <icon src="resources/ios/AppIcon-40.png"   width="40"   height="40" />
    <icon src="resources/ios/AppIcon-29.png"   width="29"   height="29" />
    <icon src="resources/ios/AppIcon-20.png"   width="20"   height="20" />

    <splash src="resources/ios/splash-2732x2732.png" width="2732" height="2732" />
    <splash src="resources/ios/splash-2048x2732.png" width="2048" height="2732" />
    <splash src="resources/ios/splash-1668x2388.png" width="1668" height="2388" />
    <splash src="resources/ios/splash-1242x2688.png" width="1242" height="2688" />
    <splash src="resources/ios/splash-1125x2436.png" width="1125" height="2436" />
    <splash src="resources/ios/splash-828x1792.png"  width="828"  height="1792" />
    <splash src="resources/ios/splash-750x1334.png"  width="750"  height="1334" />
    <splash src="resources/ios/splash-640x1136.png"  width="640"  height="1136" />
  </platform>

  <plugin name="cordova-plugin-device" spec="3.0.0" />
  <plugin name="cordova-plugin-network-information" spec="3.1.0" />
  <plugin name="cordova-plugin-statusbar" spec="4.0.0" />
  <plugin name="cordova-plugin-inappbrowser" spec="6.0.0" />
  <plugin name="cordova-plugin-file" spec="8.1.3" />
  <plugin name="cordova-plugin-geolocation" spec="5.0.0" />

  <engine name="android" spec="15.0.0" />
  <engine name="ios"     spec="8.0.1" />
</widget>
